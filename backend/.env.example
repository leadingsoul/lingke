# ==========================================
# 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# .env 文件不会被提交到 Git（已在 .gitignore 中排除）
# ==========================================

# ── 应用基础 ──
APP_NAME=E-Commerce After-Sales Service
APP_VERSION=1.0.0
DEBUG=true
ENV=development

# ── 服务端口 ──
HOST=0.0.0.0
PORT=8000

# ── JWT 鉴权 ──
SECRET_KEY=change-me-in-production-use-a-strong-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 数据库 ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ecommerce_service

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── LLM API（DeepSeek，不填 Key 则引擎启动但调用时报错） ──
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30

# ── AES 手机号加密 ──
AES_KEY=change-me-32byte-aes-key-here!!
AES_IV=change-me-16byte

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── 文件上传 ──
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=jpg,jpeg,png
